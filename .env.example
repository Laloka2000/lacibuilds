# Copy to .env.local for local development, and set the same keys on Vercel.
# Without NEWSLETTER_API_KEY the forms only log to the terminal in development.

NEWSLETTER_API_KEY=
NEWSLETTER_ENDPOINT=https://api.buttondown.com/v1/subscribers
NEWSLETTER_TAG=newsletter
WAITLIST_TAG=crawlguard-waitlist

# Only once a custom domain exists. Otherwise the Vercel production URL is used.
# NEXT_PUBLIC_SITE_URL=https://example.com
